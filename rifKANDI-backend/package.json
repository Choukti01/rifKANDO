{
  "type": "commonjs",
  "name": "rifkandi-backend",
  "version": "1.0.0",
  "engines": {
    "node": "22.22.3"
  },
  "description": "rifKANDI - Multi-Service Platform Backend API",
  "main": "server.js",
  "scripts": {
    "postinstall": "npm rebuild sqlite3 --build-from-source",
    "dev": "set NODE_OPTIONS=--dns-result-order=ipv4first && nodemon server.js",
    "start": "node server.js",
    "check": "node --check server.js && node --check src/app.js && node --check src/config/database.js && node --check src/services/walletService.js && node --check src/services/cmiPaymentService.js",
    "test:financial": "node scripts/financialSmokeTest.js",
    "test:storage": "node scripts/storageSmokeTest.js",
    "backup:db": "node scripts/backupDatabase.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1042.0",
    "@getbrevo/brevo": "^5.0.3",
    "@google/generative-ai": "^0.24.1",
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^2.4.3",
    "cmi-payment-nodejs": "^1.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "google-auth-library": "^10.9.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.4",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "resend": "^6.16.0",
    "serverless-http": "^4.0.0",
    "sharp": "^0.35.3",
    "sqlite3": "^6.0.1",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
