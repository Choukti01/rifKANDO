NODE_ENV=production
PORT=5000
CLIENT_URL=https://www.rifkando.com
ALLOWED_ORIGINS=https://www.rifkando.com,https://rifkando.com
# Keep this as sqlite until the staged PostgreSQL cutover is approved.
DATABASE_ENGINE=sqlite
DATABASE_PATH=/var/data/rifkandi.db
# Render's persistent disk root. For self-hosting, set this to a dedicated
# non-root directory such as C:\\rifkando-data and keep all local data inside it.
PERSISTENT_STORAGE_ROOT=/var/data
DB_BACKUP_DIR=/var/data/backups
DB_BACKUP_RETENTION_DAYS=14
# Use local storage only for development or the single Render service. For
# horizontal scaling set OBJECT_STORAGE_DRIVER=s3 and configure every
# OBJECT_STORAGE_* value below. Public and private buckets must be different.
OBJECT_STORAGE_DRIVER=local
UPLOADS_DIR=/var/data/uploads
OBJECT_STORAGE_ENDPOINT=https://your-account.s3-provider.example
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_PUBLIC_BUCKET=rifkando-public
OBJECT_STORAGE_PRIVATE_BUCKET=rifkando-private
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=https://cdn.your-domain.example
OBJECT_STORAGE_FORCE_PATH_STYLE=false
JWT_SECRET=replace-with-a-long-random-secret
# A separate 32+ character secret used only for HttpOnly browser sessions.
SESSION_SECRET=replace-with-a-different-long-random-secret
# A separate 32+ character secret used to make the append-only audit chain tamper-evident.
AUDIT_LOG_SECRET=replace-with-a-third-long-random-secret
# A separate 32+ character secret used only to hash short-lived SMS codes.
PHONE_OTP_SECRET=replace-with-a-fourth-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Operational rollback switches. Omit this variable to use the same enabled
# defaults. Set one value to false to stop new risky operations after restart.
FEATURE_FLAGS=checkout=true,cmi_payments=false,wallet_payments=false,digital_downloads=false,courses=false,services=false,digital=false
# Required for a monitoring system to read the protected /metrics endpoint.
# Use a separate random value of at least 32 characters. Never expose it in the frontend.
METRICS_TOKEN=replace-with-a-fourth-long-random-secret
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Real phone authentication is sent by the backend through Twilio. Never put
# these credentials in the frontend, Git, logs, or support messages.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Set this only when a Messaging Service is not used.
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
EMAIL_FROM=rifKANDO <no-reply@your-verified-domain.example>
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=rifKANDO
CMI_STORE_KEY=
CMI_CLIENT_ID=
BACKEND_URL=https://your-backend.example.com
# PostgreSQL cutover only. Set DATABASE_ENGINE=postgres only after the schema,
# importer, and staging validation have succeeded.
# DATABASE_URL=postgresql://username:password@host:5432/rifkando
# POSTGRES_SSL=true
# POSTGRES_POOL_MAX=5
# POSTGRES_CONNECT_TIMEOUT_MS=10000
# POSTGRES_IDLE_TIMEOUT_MS=30000
