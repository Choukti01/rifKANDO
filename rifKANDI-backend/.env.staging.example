# Deployed staging uses NODE_ENV=production so cookies and security headers
# match production. APP_ENV keeps data, credentials, and payment mode separate.
NODE_ENV=production
APP_ENV=staging
PORT=5000
CLIENT_URL=https://your-staging-frontend.example.com
ALLOWED_ORIGINS=https://your-staging-frontend.example.com
DATABASE_PATH=/var/data/rifkandi-staging.db
DB_BACKUP_DIR=/var/data/backups
DB_BACKUP_RETENTION_DAYS=14
OBJECT_STORAGE_DRIVER=local
UPLOADS_DIR=/var/data/uploads
JWT_SECRET=replace-with-a-unique-staging-secret-of-at-least-32-characters
SESSION_SECRET=replace-with-a-different-unique-staging-secret-of-at-least-32-characters
AUDIT_LOG_SECRET=replace-with-a-third-unique-staging-secret-of-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
FEATURE_FLAGS=checkout=true,cmi_payments=true,digital_downloads=true
GOOGLE_CLIENT_ID=your-staging-google-web-client-id.apps.googleusercontent.com
RESEND_API_KEY=
EMAIL_FROM=rifKANDO Staging <no-reply@your-verified-domain.example>
# Leave all CMI variables empty unless CMI has supplied separate test credentials.
CMI_STORE_KEY=
CMI_CLIENT_ID=
BACKEND_URL=
