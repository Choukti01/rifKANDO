# Copy to /opt/rifkando/.env on the VM (permissions 600). Do not commit it.
# Obtain every secret from the existing production environment; do not invent
# replacements while the Windows origin still serves live traffic.
NODE_ENV=production
APP_ENV=production
PORT=5000
DATABASE_ENGINE=postgres
POSTGRES_SSL=true
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

CLIENT_URL=https://www.rifkando.com
ALLOWED_ORIGINS=https://www.rifkando.com,https://rifkando.com
BACKEND_URL=https://api.rifkando.com

JWT_SECRET=replace-with-existing-production-value
SESSION_SECRET=replace-with-existing-production-value
AUDIT_LOG_SECRET=replace-with-existing-production-value
PHONE_OTP_SECRET=replace-with-existing-production-value
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Preserve the current controlled launch scope.
FEATURE_FLAGS=checkout=true,cmi_payments=false,digital_downloads=false
OBJECT_STORAGE_DRIVER=local

